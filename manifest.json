{
  "manifest_version": 3,
  "name": "ThreadMind Sync",
  "version": "1.0",
  "permissions": ["debugger", "storage", "tabs"],
  "host_permissions": [
    "https://twitter.com/*",
    "https://x.com/*",
    "http://localhost:3000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://twitter.com/i/bookmarks",
        "https://x.com/i/bookmarks"
      ],
      "js": ["content.js"],
      "css": ["style.css"]
    }
  ]
}
